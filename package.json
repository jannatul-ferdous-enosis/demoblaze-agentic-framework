{
  "name": "demoblaze-qa-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Skills-based QA Agent framework for Demoblaze (Single Agent + Multi-Skill)",
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit -p automation/tsconfig.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "playwright test --config=automation/playwright.config.ts",
    "test:smoke": "playwright test --config=automation/playwright.config.ts --grep @smoke",
    "test:ui": "playwright test --config=automation/playwright.config.ts --ui",
    "test:report": "playwright show-report reports/html-report",
    "agent:skill": "tsx scripts/run-skill.ts",
    "agent:pipeline": "tsx scripts/run-agent.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/node": "^22.10.0",
    "@typescript-eslint/eslint-plugin": "^8.16.0",
    "@typescript-eslint/parser": "^8.16.0",
    "dotenv": "^18.0.6",
    "eslint": "^9.16.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.71.1"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
