# Demoblaze QA Agent environment variables
# Copy this file to `.env` and fill in real values (do NOT commit .env).

# Base URL of the target application
DEMOBLAZE_BASE_URL=https://www.demoblaze.com

# API base URL (used for direct signup helper that bypasses the UI)
DEMOBLAZE_API_URL=https://api.demoblaze.com

# Browser execution mode: 'true' to run headed, 'false' for headless
HEADLESS=false

# CI mode toggles retries and worker counts
CI=false

# Default test timeout (ms)
DEFAULT_TIMEOUT=15000